{
  "schema_version": "1.0.0",
  "phase": "single_scene_process_api_chip",
  "pilot_config": "config/sar_copernicus_pilot.json",
  "request": {
    "crs": "http://www.opengis.net/def/crs/OGC/1.3/CRS84",
    "width_px": 1934,
    "height_px": 2002,
    "maximum_dimension_px": 2500,
    "maximum_response_bytes": 100663296,
    "bands": [
      "VV",
      "VH",
      "dataMask"
    ],
    "band_units": [
      "LINEAR_POWER",
      "LINEAR_POWER",
      "DN"
    ],
    "sample_type": "FLOAT32",
    "format": "image/tiff",
    "data_filter": {
      "resolution": "HIGH",
      "acquisition_mode": "IW",
      "polarization": "DV",
      "orbit_direction": "DESCENDING",
      "mosaicking_order": "mostRecent"
    },
    "processing": {
      "back_coeff": "GAMMA0_ELLIPSOID",
      "orthorectify": true,
      "dem_instance": "COPERNICUS_30",
      "speckle_filter": "NONE",
      "radiometric_terrain_correction": false
    },
    "minimum_valid_fraction": 0.8
  },
  "guardrails": {
    "manual_workflow_only": true,
    "confirmation_phrase": "PROCESS_ONE_SCENE",
    "catalogue_must_return_one_scene": true,
    "temporary_raster_only": true,
    "delete_raster_after_validation": true,
    "persist_raster": false,
    "upload_raster_artifact": false,
    "perform_detection": false,
    "download_ais": false,
    "publish_public_layer": false,
    "modify_gfw_products": false,
    "modify_magic_paws": false,
    "current_ais_must_not_be_overlaid": true
  }
}
